# Settings for `docker compose up`. Copy to .env and edit. Never commit .env.

# REQUIRED. A long random string that signs login tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Where browsers reach the app. These defaults are right for running on your own computer.
# For a real server, use your public addresses (https:// and wss://).
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4001
PUBLIC_GATEWAY_URL=ws://localhost:4000

# Use MongoDB Atlas instead of the bundled MongoDB (leave empty to use the bundled one):
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# Object storage for uploads. The defaults use the bundled MinIO. For Cloudflare R2 / AWS S3,
# set all of these (see docs/DEPLOY.md):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=synapse-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
