{
  "name": "synapse-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "REDIS_URL=redis://127.0.0.1:6379 tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "REDIS_URL=redis://127.0.0.1:6379 tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "bench:propagation": "tsx bench/propagation.ts",
    "bench:partition": "tsx bench/partition.ts",
    "bench:load": "tsx bench/load.ts",
    "bench:convergence": "tsx bench/convergence.ts",
    "test:fault": "vitest run --config vitest.fault.config.ts",
    "prune-guests": "tsx src/prune.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lib0": "^0.2.119",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
